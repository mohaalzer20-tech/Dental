NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# مطلوب فقط لمهمة التذكيرات المجدولة (/api/cron/reminders) — يتجاوز RLS، لا يُستخدم إلا بالسيرفر
# من: Supabase Dashboard → Project Settings → API → service_role secret key
SUPABASE_SERVICE_ROLE_KEY=

# Vercel يرسل هذا التوكن تلقائياً بترويسة Authorization عند تشغيل الـ cron المجدول بـ vercel.json
# اضبطه بنفس القيمة بإعدادات المشروع على Vercel (Settings → Environment Variables)
CRON_SECRET=

# مزوّد SMS — D7 Networks (يغطي سيريتل وMTN سوريا): https://d7networks.com
SMS_API_TOKEN=
SMS_SENDER_NAME=
